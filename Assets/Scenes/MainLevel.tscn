[sub_resource type="Shader" id="Shader_oc1nr"]
code = "shader_type spatial;
render_mode diffuse_lambert;

uniform vec4 primarycolor: source_color;
uniform float roughness = 0.2;
uniform vec4 color_deep : source_color;
uniform vec4 color_shallow : source_color;
uniform float beers_law = 2.0;
uniform float depth_offset = -0.75;
uniform sampler2D depth_texture : hint_depth_texture, repeat_disable;
uniform sampler2D screen_texture : hint_screen_texture, repeat_disable;
uniform sampler2D NoiseA : hint_normal;

uniform vec4 WaveA;
uniform vec4 WaveB;
uniform vec4 WaveC;

uniform vec4 foam_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float foam_amount = 0.5;
uniform float foam_cutoff = 0.7;
uniform float foam_edge_distance = 0.4;
uniform float foam_tiling = 4.0;

varying float wave_height;

vec3 GerstnerWave(vec4 wave, vec3 coord, inout vec3 tangent, inout vec3 binormal){
	float steep = wave.z;
	float wavelength = wave.w;
	float k = 2.0 * PI / wavelength;
	float c = sqrt(9.8 / k);
	vec2 d = normalize(wave.xy);
	float a = steep / k;
	float f = k * (dot(d, coord.xz) - TIME * c);

	tangent += vec3(
		-d.x * d.x * (steep * sin(f)),
		d.x * (steep * cos(f)),
		-d.x * d.y * (steep * sin(f))
	);

	binormal += vec3(
		-d.x * d.y * (steep * sin(f)),
		d.y * (steep * cos(f)),
		-d.y * d.y * (steep * sin(f))
	);

	return vec3(
		d.x * (a * cos(f)),
		a * sin(f),
		d.y * (a * cos(f))
	);
}

float fresnelpow(float amount, vec3 normal, vec3 view){
	return pow((1.0 - clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0)), amount);
}

void vertex() {
	// Initialize tangent and binormal
	TANGENT = vec3(1.0, 0.0, 0.0);
	BINORMAL = vec3(0.0, 0.0, 1.0);
	vec3 world_pos = (MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;
	VERTEX += GerstnerWave(WaveA, world_pos, TANGENT, BINORMAL);
	VERTEX += GerstnerWave(WaveB, world_pos, TANGENT, BINORMAL);
	VERTEX += GerstnerWave(WaveC, world_pos, TANGENT, BINORMAL);

	wave_height = VERTEX.y;

	NORMAL = normalize(cross(BINORMAL, TANGENT));
}

void fragment(){
	float fresnel = fresnelpow(5.0, NORMAL, VIEW);

	float depth = texture(depth_texture, SCREEN_UV).r;
	depth = depth * 2.0 - 1.0;
	vec3 ndc = vec3(SCREEN_UV*2.0-1.0,depth);
	vec4 world = INV_VIEW_MATRIX*INV_PROJECTION_MATRIX *vec4(ndc,1.0);
	float depth_texture_y = world.y/world.w;
	float vertex_y = (INV_VIEW_MATRIX* vec4(VERTEX,1.0)).y;
	float depth_blend = clamp((vertex_y -depth_texture_y / depth_offset),0.0,1.0);
	depth_blend = exp(-depth_blend*beers_law);
	float depth_blend_power = clamp(pow(depth_blend, 2.5), 0.0, 1.0);

	vec3 screen_color = textureLod(screen_texture, SCREEN_UV,depth_blend).rgb;
	vec3 depth_color = mix(color_shallow.rgb, color_deep.rgb, depth_blend);
	vec3 color = mix(depth_color.rgb, screen_color, 0.2);
	float foam_wave = smoothstep(foam_cutoff, 1.0, wave_height * foam_amount);
	float foam_edge = smoothstep(0.0, foam_edge_distance, depth_blend_power);
	foam_edge = 1.0 - foam_edge;
	vec2 foam_uv = UV * foam_tiling + vec2(TIME * 0.1, TIME * 0.05);
	float foam_tex = texture(NoiseA, foam_uv*10.0).r;
	float foam_final = max(foam_wave, foam_edge) * foam_tex;
	vec3 surface_color = primarycolor.rgb + (0.2 * fresnel);
	ALBEDO =  mix(surface_color, foam_color.rgb, foam_final);
	ROUGHNESS = roughness;
	METALLIC = 0.0;
}"

